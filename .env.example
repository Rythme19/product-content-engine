# Copy to .env (never commit .env). Restart the server after editing.

# --- Higgsfield (image + video generation) ---------------------------------
# Create an API key ID + secret at https://console.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# --- Claude (analysis, creative directions, prompts, storyboard, QC) -------
# https://console.anthropic.com → API keys. Without it the app uses editable templates.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Offline mock provider (free placeholders for testing) -----------------
# ENABLE_MOCK_PROVIDER=true

# --- Server -------------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1          # non-loopback hosts require APP_TOKEN
# APP_TOKEN=              # >= 24 random chars; required when exposed beyond localhost
# ALLOWED_HOSTS=studio.example.com   # extra Host headers to accept (comma-separated)
# DATA_DIR=./data
# MAX_IN_FLIGHT=4          # concurrent provider jobs
